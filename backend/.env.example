# Configuración del Entorno - Asesoría IA Facturas
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Base de datos (SQLite async para desarrollo local rápido)
DATABASE_URL=sqlite+aiosqlite:///./invoices_accounting.db

# Directorio de subida de archivos
UPLOAD_DIR=./uploads

# Configuración de LLM (Google GenAI o OpenAI)
# Para Gemini: Se utiliza gemini-3.8-flash (o gemini-flash-latest)
GEMINI_API_KEY=
# Para OpenAI (opcional): Se utiliza gpt-4o / gpt-4o-mini
OPENAI_API_KEY=

# Proveedor preferido de LLM: "gemini" o "openai"
DEFAULT_LLM_PROVIDER=gemini
